# Required. Generate with: openssl rand -base64 36
API_KEY=replace-with-at-least-24-random-characters

PORT=8000
HOST=0.0.0.0
PUBLIC_BASE_URL=
LOG_LEVEL=info

# Koyeb free-instance defaults (512 MB RAM / 2 GB SSD)
CACHE_DIR=/tmp/torrent-window-gateway
CACHE_MAX_MB=768
TORRENT_CACHE_MAX_MB=512
WINDOW_AHEAD_MB=48
WINDOW_BEHIND_MB=8
EVICTION_GRACE_SECONDS=15
GC_INTERVAL_SECONDS=5

MAX_TORRENTS=3
MAX_PLAYBACKS=6
MAX_PLAYBACKS_PER_IP=3
MAX_CONCURRENT_STREAMS=6
MAX_STREAMS_PER_PLAYBACK=2
MAX_PEER_CONNECTIONS=24

METADATA_TIMEOUT_SECONDS=60
PIECE_TIMEOUT_SECONDS=45
PLAYBACK_IDLE_SECONDS=90
PLAYBACK_MAX_HOURS=4
TORRENT_IDLE_MINUTES=15

MAX_TORRENT_FILE_MB=2
MAX_TORRENT_SIZE_GB=100
MAX_TORRENT_FILES=10000
MAX_TORRENT_PIECES=100000

# Per HTTP viewer. 0 disables throttling.
STREAM_MAX_MBIT=20
STREAM_CHUNK_KB=256

# Resource-conservative defaults. Set slots > 0 only for content you may seed.
UPLOAD_SLOTS=0
UPLOAD_LIMIT_KBPS=128
DOWNLOAD_LIMIT_MBIT=0

# Security / embedding
CORS_ORIGINS=*
FRAME_ANCESTORS=*
BIND_PLAYBACK_TO_IP=false
ALLOW_PRIVATE_NETWORKS=false
ALLOW_WEB_SEEDS=false
